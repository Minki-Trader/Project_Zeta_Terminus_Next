    "newsy_target_months": [
      1,
      4,
      7,
      10
    ],
    "origin_and_target": "At the end of origin month t, predict target month t+1.",
    "raw_predictor": "Sum the returns of the latest four newsy months known by the end of t.",
    "demeaning": "Subtract the expanding mean of the raw four-newsy-month sum over strictly earlier origin months.",
    "target_flip": "Multiply the demeaned predictor by -1 when t+1 is newsy and by +1 otherwise.",
    "expanding_beta": "Fit an OLS slope with intercept of realized next-month return on the flipped demeaned predictor using origin rows through t-1, whose target returns are known by the end of t.",
    "paper_portfolio_excess_weight": "expanding_beta times flipped_demeaned_predictor",
    "executable_direction": "LONG when paper portfolio excess weight is positive and SHORT when negative; zero is flat and must not be thresholded.",
    "no_flip_control": "Use the same source expanding beta but suppress only the target-month sign flip before taking direction.",
    "long_only_control": "LONG every eligible cash session.",
    "thresholds_or_grid_points": 0
  },
