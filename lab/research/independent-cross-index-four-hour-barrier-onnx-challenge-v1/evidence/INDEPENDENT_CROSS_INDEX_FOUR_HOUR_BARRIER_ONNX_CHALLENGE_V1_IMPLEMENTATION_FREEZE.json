  "implementation_semantics": {
    "feature_tensor": "the prior 48 completed common H1 bars; five channels per symbol in US100, US30, US500 order plus four decision-calendar channels",
    "atr": "24 completed-bar simple mean true range; the decision uses the ATR at the immediately preceding completed common H1 bar",
    "volume_zscore": "current log1p tick volume against the population mean and standard deviation of the prior 24 completed bars",
    "quote_book": "CSV OHLC is treated as Bid; recorded spread times 0.01 constructs Ask at the decision and throughout its four-bar proxy path",
    "label_order": "each direction checks its adverse stop before favorable take inside every ordered future bar; FLAT is assigned unless exactly one direction wins",
    "stress": "the spread-aware actual path includes one recorded round-trip spread and the stressed book subtracts one additional decision spread",
    "selection_tie_break": "higher direction probability, then US100/US30/US500 order, then LONG before SHORT",
    "normal_trading_day": "a server date containing at least 20 common H1 bars; every such zero-signal day remains in the denominator",
    "portfolio_capacity": "one position; capacity returns only at the common H1 open after the exit bar",
    "output_atomicity": "development and confirmation artifacts stage under their family artifact root and become authoritative only after complete directory replacement"
